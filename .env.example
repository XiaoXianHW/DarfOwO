# Copy to .env.local and fill in real values. .env* is gitignored.

# Mi Fitness (DarfAPI) health API key.
# Injected server-side by the Vite dev/preview proxy (see vite.config.ts) so it
# is never exposed in the client bundle. For production, configure an equivalent
# reverse proxy that maps /api/mifitness/* -> https://api.xiaoxian.org/api/v1/mi-fitness/*
# and adds the "Authorization: Bearer <key>" header.
MIFITNESS_API_KEY=

# Optional: override the upstream API base used by the proxy.
MIFITNESS_API_BASE=https://api.xiaoxian.org

# Mi Fitness relative uid whose health data is displayed on the Status page.
VITE_MIFITNESS_UID=2706034380

# Optional: Mi login session ID used for the health queries.
VITE_MIFITNESS_SESSION_ID=5fd053625cc1d165b3d8f3fd
